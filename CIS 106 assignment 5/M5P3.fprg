<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M5P3"/>
        <attribute name="authors" value="shama"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-13 09:42:32 PM"/>
        <attribute name="created" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTAtMTM7MDk6Mzc6MDggUE07MjkzNw=="/>
        <attribute name="edited" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTAtMTM7MDk6NDI6MzIgUE07MTszMDM4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="books" type="Integer" array="False" size=""/>
            <declare name="costperbook, ordertotal, shipping" type="Real" array="False" size=""/>
            <input variable="books"/>
            <input variable="costperbook"/>
            <assign variable="ordertotal" expression="books*costperbook"/>
            <if expression="ordertotal&gt;50.00">
                <then>
                    <assign variable="shipping" expression="0.00"/>
                </then>
                <else>
                    <assign variable="shipping" expression="25.00"/>
                </else>
            </if>
            <output expression="&quot;Total: $&quot; &amp; ordertotal &amp; &quot;, Shipping: $&quot; &amp; shipping" newline="True"/>
        </body>
    </function>
</flowgorithm>
