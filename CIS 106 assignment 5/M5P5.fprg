<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M5P5"/>
        <attribute name="authors" value="shama"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-13 10:01:29 PM"/>
        <attribute name="created" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTAtMTM7MDk6NDg6NDEgUE07MjkzNg=="/>
        <attribute name="edited" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTAtMTM7MTA6MDE6MjkgUE07MTszMDMx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lastname" type="String" array="False" size=""/>
            <declare name="dependents" type="Integer" array="False" size=""/>
            <declare name="grossincome, adjustedgrossincome, taxrate, incometax" type="Real" array="False" size=""/>
            <input variable="lastname"/>
            <input variable="dependents"/>
            <input variable="grossincome"/>
            <assign variable="adjustedgrossincome" expression="grossincome-(dependents*12000)"/>
            <if expression="adjustedgrossincome&gt;50000">
                <then>
                    <assign variable="taxrate" expression="0.20"/>
                </then>
                <else>
                    <assign variable="taxrate" expression="0.10"/>
                </else>
            </if>
            <assign variable="incometax" expression="adjustedgrossincome*taxrate"/>
            <if expression="incometax&lt;0">
                <then>
                    <assign variable="incometax" expression="100.00"/>
                </then>
                <else/>
            </if>
            <output expression="&quot;Tax due for &quot; &amp; lastname &amp; &quot;: $&quot; &amp; incometax" newline="True"/>
        </body>
    </function>
</flowgorithm>
